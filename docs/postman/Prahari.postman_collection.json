			"name": "Authentication",
			"item": [
				{
					"name": "Obtain Token",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"username\": \"{{username_placeholder}}\",\n    \"password\": \"{{password_placeholder}}\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/auth/token/",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"auth",
								"token",
								""
							]
						},
						"description": "Obtain simple JWT token pair for Coordinator"
					},
					"response": []
